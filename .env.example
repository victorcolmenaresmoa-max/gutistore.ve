# ==============================
# GutiStore · Variables de entorno
# ==============================

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave privada de servidor (recomendado: sb_secret_...).
# También se admite SUPABASE_SERVICE_ROLE_KEY como compatibilidad legacy.
# NUNCA uses NEXT_PUBLIC_ para estas claves.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage. La migración crea este bucket público por defecto.
SUPABASE_STORAGE_BUCKET=guti-store-media

# Acceso al panel /admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URL pública final de la tienda, sin slash final.
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Notificación automática de nuevos pedidos (Resend)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
# Remitente verificado en Resend. Ejemplo: GutiStore <pedidos@tudominio.com>
EMAIL_FROM=
