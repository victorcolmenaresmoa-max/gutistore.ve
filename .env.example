# URL del proyecto. Supabase > Project Settings > API.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave SECRETA del proyecto: sb_secret_... (recomendada)
# También se admite temporalmente la clave legacy service_role mediante
# SUPABASE_SERVICE_ROLE_KEY. Nunca uses NEXT_PUBLIC_ para estas claves.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZA_AQUI

# Contraseña para entrar a /admin. Se valida solamente en el servidor.
ADMIN_PASSWORD=coloca-una-contrasena-segura

# Cadena aleatoria larga para firmar la cookie del panel administrativo.
# Debe ser distinta de ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=coloca-una-cadena-aleatoria-de-al-menos-32-caracteres

# (Opcional) Dominio público de la tienda, para enlaces y vistas previas al compartir.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# (Opcional) Avisos de pedidos nuevos por Telegram. Ver TELEGRAM.md.
# Token del bot que te da @BotFather.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Tu ID de chat (o varios separados por coma; los de grupos empiezan con -).
# TELEGRAM_CHAT_ID=123456789
